# Variables d'environnement pour le développement local (docker-compose.dev.yml)
# Copier ce fichier en .env.dev puis l'adapter si besoin.

# Base de données (les valeurs DB_HOST/DB_PORT sont forcées dans compose dev)
DB_HOST=mariadb
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpass
DB_NAME=projet_location

# JWT (valeurs de dev uniquement, à ne JAMAIS utiliser en production)
JWT_SECRET=dev_secret_change_me_please_long_random_string
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_DAYS=30

# Serveur
PORT=3000

# URL de l'application en local (pour les liens photos)
APP_URL=http://localhost:3000
